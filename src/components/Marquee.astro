---
import { evento } from "../config";

const itens = [
  evento.data,
  evento.horario,
  `${evento.formato} · ${evento.local.cidade}`,
  `${evento.local.nome} · ${evento.local.predio}`,
  evento.selos[0],
  evento.selos[1],
];
// Duplicado para o loop contínuo (a segunda metade cobre o -50%).
const loop = [...itens, ...itens];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      loop.map((t) => (
        <span class="marquee__item">
          <span class="marquee__dot" />
          {t}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    background: var(--navy-darkest);
    border-block: 1px solid rgba(206, 147, 117, 0.16);
    overflow: hidden;
    position: relative;
    z-index: 2;
  }
  .marquee::before,
  .marquee::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(3rem, 8vw, 8rem);
    z-index: 1;
    pointer-events: none;
  }
  .marquee::before {
    left: 0;
    background: linear-gradient(90deg, var(--navy-darkest), transparent);
  }
  .marquee::after {
    right: 0;
    background: linear-gradient(270deg, var(--navy-darkest), transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 34s linear infinite;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    padding-block: 0.9rem;
    padding-right: 1.4rem;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-navy);
  }
  .marquee__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--copper);
    box-shadow: 0 0 0 3px rgba(192, 106, 63, 0.18);
    flex: none;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      justify-content: center;
    }
  }
</style>
