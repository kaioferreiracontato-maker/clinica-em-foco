---
import { ganhos } from "../config";
---

<section class="section section--navy" id="ganhos">
  <div class="container">
    <header class="ganhos__head reveal">
      <p class="eyebrow">O que você desenvolve</p>
      <h2 class="ganhos__title">Do sintoma borrado à hipótese nítida.</h2>
      <p class="ganhos__sub">
        Quatro competências que você leva para o consultório já na segunda-feira.
      </p>
    </header>

    <ol class="ganhos__grid">
      {
        ganhos.map((g, i) => (
          <li class="ganho reveal">
            <span class="ganho__num">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="ganho__title">{g.titulo}</h3>
            <p class="ganho__desc">{g.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ganhos__head {
    max-width: 40ch;
  }
  .ganhos__title {
    margin-top: 1.1rem;
    font-size: var(--step-3);
    color: var(--on-navy-strong);
  }
  .ganhos__sub {
    margin-top: 1rem;
    color: var(--on-navy);
    max-width: 46ch;
  }
  .ganhos__grid {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    counter-reset: none;
  }
  @media (min-width: 40rem) {
    .ganhos__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 68rem) {
    .ganhos__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ganho {
    position: relative;
    padding: 1.7rem 1.5rem 1.8rem;
    background: linear-gradient(180deg, var(--navy-card), color-mix(in srgb, var(--navy-card) 60%, var(--navy-deep)));
    border: 1px solid var(--navy-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .ganho:hover {
    transform: translateY(-4px);
    border-color: var(--copper-soft);
  }
  .ganho__num {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--copper);
    opacity: 0.9;
  }
  .ganho__title {
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--on-navy-strong);
  }
  .ganho__desc {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--on-navy);
    line-height: 1.55;
  }
</style>
