---
import { depoimentos, facilitadora } from "../config";
---

<section class="section section--ivory prova" id="depoimentos">
  <div class="container">
    <header class="prova__head reveal">
      <p class="eyebrow">O que dizem</p>
      <h2 class="prova__title">
        Profissionais que aprenderam a pensar a clínica com {facilitadora.nome}.
      </h2>
    </header>

    <ul class="prova__grid">
      {
        depoimentos.itens.map((d) => (
          <li class="prova__card reveal">
            <p class="prova__quote">{d.texto}</p>
            <footer class="prova__autor">
              <span class="prova__nome">{d.nome}</span>
              <span class="prova__formacao">{d.formacao}</span>
            </footer>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .prova__head {
    max-width: 40ch;
  }
  .prova__title {
    margin-top: 1.1rem;
    font-size: var(--step-2);
    color: var(--on-ivory);
  }
  .prova__grid {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 1rem + 3vw, 3.2rem);
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .prova__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .prova__card {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    padding: 1.7rem 1.6rem;
    background: var(--ivory-card);
    border: 1px solid var(--ivory-line);
    border-radius: var(--radius);
  }
  .prova__quote {
    position: relative;
    padding-top: 1.6rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--on-ivory);
  }
  .prova__quote::before {
    content: "\201C";
    position: absolute;
    top: -0.4rem;
    left: -0.2rem;
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--copper);
    opacity: 0.55;
  }
  .prova__autor {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ivory-line);
  }
  .prova__nome {
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--on-ivory);
  }
  .prova__formacao {
    font-size: var(--step--1);
    color: var(--on-ivory-muted);
  }
</style>
